---
import "../styles/global.css";
import Fonts from "./Fonts.astro";
import { menuItems } from "../lib/menu";
import { cn } from "cn";

const path = Astro.url.pathname;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Fonts />
        <title>Astro</title>
    </head>
    <body class="bg-ctp-crust text-ctp-text">
        <div class="max-w-3xl mx-auto w-full flex p-2 gap-1">
            <a href="" class="font-mono">
                Ingo Wolf
            </a>
            <div class="grow"></div>
            {menuItems.map((item) => (
                <>
                    <a
                        href={item.href}
                        class={cn(
                            "px-2 py-0.5 hover:bg-ctp-base active:opacity-90",
                            {
                                "bg-ctp-mauve text-ctp-crust hover:bg-ctp-mauve":
                                    item.href === path,
                            },
                        )}
                    >
                        {item.title}
                    </a>
                </>
            ))}
        </div>
        <slot />
    </body>
</html>
